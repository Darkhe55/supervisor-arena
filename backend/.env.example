# supervisor-arena — local development environment template
#
# Usage: cp backend/.env.example backend/.env
#
# H-53 (fail-closed): the 5 fields marked with `(H-53 REQUIRED)` below have
# NO fallback in code. If any is empty or missing, the app panics on startup
# with a clear error. The dev placeholders here pass the format check
# (non-empty + valid hex / URL syntax) so `cargo run` works out of the box
# for local development. For production, generate real values and inject
# via your secret manager.
#
# Generate secrets:
#   openssl rand -hex 64   # 64 hex chars = 32 bytes (for field_key / hmac_salt_key)
#   openssl rand -hex 64   # 64+ hex chars for JWT secret

# ===== Server =====
SERVER__HOST=0.0.0.0
SERVER__PORT=8080
SERVER__WORKERS=4
RUST_LOG=info,supervisor_arena=debug,tokio_postgres=info,deadpool=info

# ===== Database (PostgreSQL) — H-53 REQUIRED =====
# Format: postgres://user:password@host:port/dbname
# Port 5433 (not 5432) is the docker-compose mapping for this project —
# the local postgresql-x64-16 service on Windows binds 5432 and would
# otherwise shadow the docker port forward.
DATABASE__URL=postgres://supervisor:supervisor_dev_pwd@localhost:5433/supervisor_arena
DATABASE__MAX_CONNECTIONS=20
DATABASE__MIN_CONNECTIONS=2
DATABASE__ACQUIRE_TIMEOUT_SECS=5

# ===== Redis — H-53 REQUIRED =====
REDIS__URL=redis://localhost:6379
REDIS__POOL_SIZE=10

# ===== Auth (JWT) — H-53 REQUIRED =====
# Generate with: openssl rand -hex 64
# Must be at least 32 bytes (H-53 length check)
AUTH__JWT_SECRET=replace_with_64_byte_hex_string_at_least_64_chars_long_for_dev_only
AUTH__JWT_ACCESS_TTL_SECS=900           # 15 minutes
AUTH__JWT_REFRESH_TTL_SECS=604800       # 7 days

# ===== Encryption (G-8) — H-53 REQUIRED =====
# 32-byte key for AES-256-GCM, hex-encoded (must be exactly 64 hex chars).
# DEV PLACEHOLDER: starts with `deadbeef` so LocalKeyStore can detect and warn
# at startup. REPLACE with real keys before deploying:
#   openssl rand -hex 32
ENCRYPTION__FIELD_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
# 32-byte HMAC-SHA256 key for one-way hashing, hex-encoded.
ENCRYPTION__HMAC_SALT_KEY=deadbeefdeadbeefdeadbeefdeadbeefcafebabecafebabecafebabecafebabe
# Key rotation interval (days)
ENCRYPTION__KEY_ROTATION_DAYS=90

# ===== Rate Limiting =====
RATE_LIMIT__RATINGS_PER_DAY_BASIC=10
RATE_LIMIT__RATINGS_PER_DAY_MEMBER=30
RATE_LIMIT__LOGIN_PER_MIN=5

# ===== Scoring Limits =====
RATING__MAX_PER_SUPERVISOR_BASIC=3
RATING__MAX_PER_SUPERVISOR_MEMBER=10

# ===== Alias Generator =====
ALIAS__LITERARY_WORDS=300
ALIAS__NATURE_WORDS=300
ALIAS__WHITELIST_REFRESH_DAYS=90

# ===== k-Anonymity =====
K_ANONYMITY__THRESHOLD=10

# ===== Review (M1 simplified: auto-pass) =====
REVIEW__SLA_HOURS_WORKDAY=24
REVIEW__SLA_HOURS_OFFHOURS=72
# M1: review.mode = "auto_pass" | "manual"
REVIEW__MODE=auto_pass

# ===== Logging =====
LOGGING__FORMAT=pretty         # pretty | json
LOGGING__RETENTION_DAYS=30

