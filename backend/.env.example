# ===== Server =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_WORKERS=4
RUST_LOG=info,supervisor_arena=debug,sqlx=warn

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgres://supervisor:supervisor_dev_pwd@localhost:5432/supervisor_arena
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_ACQUIRE_TIMEOUT_SECS=5

# ===== Redis =====
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=10

# ===== Auth (JWT) =====
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_64_byte_hex_string_at_least_64_chars_long_for_dev_only
JWT_ACCESS_TTL_SECS=900           # 15 minutes
JWT_REFRESH_TTL_SECS=604800       # 7 days

# ===== Encryption (G-8) =====
# 32-byte key for AES-256-GCM, hex-encoded (64 hex chars)
# Generate with: openssl rand -hex 32
ENCRYPTION_FIELD_KEY=replace_with_64_hex_chars_dev_only_do_not_use_in_prod
# 32-byte HMAC-SHA256 key for one-way hashing, hex-encoded
# Generate with: openssl rand -hex 32
HMAC_SALT_KEY=replace_with_64_hex_chars_dev_only_do_not_use_in_prod
# Key rotation interval (days)
ENCRYPTION_KEY_ROTATION_DAYS=90

# ===== Rate Limiting =====
RATE_LIMIT_RATINGS_PER_DAY_BASIC=10
RATE_LIMIT_RATINGS_PER_DAY_MEMBER=30
RATE_LIMIT_LOGIN_PER_MIN=5

# ===== Scoring Limits =====
RATING_MAX_PER_SUPERVISOR_BASIC=3
RATING_MAX_PER_SUPERVISOR_MEMBER=10

# ===== Alias Generator =====
ALIAS_LITERARY_WORDS=300
ALIAS_NATURE_WORDS=300
ALIAS_WHITELIST_REFRESH_DAYS=90

# ===== k-Anonymity =====
K_ANONYMITY_THRESHOLD=10

# ===== Review (M1 simplified: auto-pass) =====
REVIEW_SLA_HOURS_WORKDAY=24
REVIEW_SLA_HOURS_OFFHOURS=72
# M1: review_mode = "auto_pass" | "manual"
REVIEW_MODE=auto_pass

# ===== Logging =====
LOG_FORMAT=pretty         # pretty | json
LOG_RETENTION_DAYS=30
